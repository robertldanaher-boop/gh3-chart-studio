@echo off
setlocal
rem Invoked from START_WINDOWS.cmd with the application root as current directory.
rem No execution-policy changes, elevation request, PATH changes or security exclusions.
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; $installer=$null; try { if (-not [Environment]::Is64BitOperatingSystem) { throw '64-bit Windows is required.' }; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $installer=Join-Path $env:TEMP ('gh3-python-'+[Guid]::NewGuid().ToString('N')+'.exe'); Write-Host 'Downloading Python 3.11.9 x64 from python.org...'; Invoke-WebRequest -UseBasicParsing -Uri 'https://www.python.org/ftp/python/3.11.9/python-3.11.9-amd64.exe' -OutFile $installer; Write-Host 'Verifying the Python Software Foundation signature...'; $signature=Get-AuthenticodeSignature -FilePath $installer; if ($signature.Status -ne 'Valid' -or $signature.SignerCertificate.Subject -notmatch '(^|,\s*)O=Python Software Foundation(,|$)') { throw 'Python installer signature verification failed. Nothing was installed.' }; $target=Join-Path $env:LOCALAPPDATA 'Programs\Python\Python311'; $log=Join-Path (Get-Location) 'python_install.log'; $quote=[char]34; $arguments='/passive /norestart InstallAllUsers=0 Include_launcher=0 Include_pip=1 Include_tcltk=1 Include_test=0 Include_doc=0 Include_dev=0 Shortcuts=0 PrependPath=0 TargetDir='+$quote+$target+$quote+' /log '+$quote+$log+$quote; Write-Host 'Installing Python with pip and Tcl/Tk. The installer shows its own progress.'; $process=Start-Process -FilePath $installer -ArgumentList $arguments -Wait -PassThru; if ($process.ExitCode -eq 3010) { throw 'Python installed but Windows requests a restart. Restart Windows, then run START_WINDOWS.cmd again.' }; if ($process.ExitCode -ne 0) { throw ('Python installer failed with exit code '+$process.ExitCode+'. See python_install.log; an existing newer 3.11 installation may need repair using its matching installer.') }; Write-Host 'Python installation complete.' } catch { Write-Host ('ERROR: '+$_.Exception.Message); Add-Content -LiteralPath 'startup_bootstrap.log' -Value ('Python setup error: '+$_.Exception.Message); exit 1 } finally { if ($installer -and (Test-Path -LiteralPath $installer)) { Remove-Item -LiteralPath $installer -Force -ErrorAction SilentlyContinue } }"
exit /b %errorlevel%
